{
  "name": "HotelFlexi — Hotel Management & PMS",
  "short_name": "HotelFlexi",
  "description": "All-in-one cloud hotel PMS, 2-way OTA channel manager, and autonomous AI hotel assistant by NovaX AI.",
  "start_url": "/login",
  "id": "/login",
  "scope": "/",
  "dir": "ltr",
  "lang": "en-IN",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "portrait-primary",
  "background_color": "#0f172a",
  "theme_color": "#1e40af",
  "categories": ["business", "travel", "productivity"],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=in.novaxai.hotelflexi",
      "id": "in.novaxai.hotelflexi"
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "edge_side_panel": {
    "preferred_width": 420
  },
  "scope_extensions": [
    {
      "origin": "https://hotelflexi.novaxai.in"
    }
  ],
  "share_target": {
    "action": "/app/reservations/new",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "HotelFlexi Cloud PMS Front Desk & Live Channel Manager"
    },
    {
      "src": "/screenshot-mobile.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "HotelFlexi Mobile Front Desk, Reservations & Housekeeping Siren"
    }
  ],
  "shortcuts": [
    {
      "name": "Front Desk & Reservations",
      "short_name": "Front Desk",
      "description": "View calendar reservations and room check-ins",
      "url": "/app/calendar",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Live Channel Manager",
      "short_name": "OTA Sync",
      "description": "Manage 2-way OTA rates and inventory",
      "url": "/app/channels",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Housekeeping & Urgency Siren",
      "short_name": "Housekeeping",
      "description": "Housekeeping tasks and urgent guest complaints",
      "url": "/app/housekeeping",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "New Guest Booking",
      "short_name": "New Booking",
      "description": "Create instant walk-in reservation",
      "url": "/app/reservations/new",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
